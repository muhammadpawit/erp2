  }
  public function totalKredit($ref_akun,$data=array()){
    $sql="SELECT COALESCE(SUM(kredit),0) as totalkredit FROM jurnal_umum_detail jd JOIN jurnal_umum ju ON(jd.jurnal_id=ju.id) WHERE ju.hapus=0 AND jd.hapus=0 ";
    if(!empty($ref_akun)){
      $sql .=" AND jd.ref_akun='".$ref_akun."'";
    }
    if(!empty($data['filter_date_start'])){
        $sql .=" AND tanggal >= '".$data['filter_date_start']."'";
    }
    if(!empty($data['filter_date_end'])){
        $sql .=" AND tanggal <= '".$data['filter_date_end']."'";
    }
    if($data['filter_ref'] != null){
        $sql .=" AND ref='".$data['filter_ref']."' ";
    }
    $result=$this->db->query($sql);

    /*if($ref_akun < 2000){
      $hasil=$result->row['totaldebet'] - $result->row['totalkredit'];
    }else{
      $hasil=$result->row['totalkredit'] - $result->row['totaldebet'];
    }*/
    $this->log->write('Hasil ' . $sql);
    //$hasil=$result->row['totaldebet'] - $result->row['totalkredit'];
    return $result->row['totalkredit'];
  }


}
