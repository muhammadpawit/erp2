				$action[] = array(
					'text' => 'Edit Mutasi',
					'href' => $this->url->link('keuangan/bank/editmutasi', 'token=' . $this->session->data['token'] . '&bank_id='.$bank_id.'&id=' . $result['id'].$url, 'SSL')
				);
